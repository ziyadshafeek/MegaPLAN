{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/folder/:path*", "destination": "/index.html" },
    { "source": "/tools/:path*", "destination": "/index.html" },
    { "source": "/wiki/:path*", "destination": "/index.html" },
    { "source": "/self", "destination": "/index.html" },
    { "source": "/desk/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "functions": {
    "api/split-pdf.js": { "maxDuration": 60 },
    "api/ai.js": { "maxDuration": 60 },
    "api/agent-plan.js": { "maxDuration": 60 },
    "api/agent-publish.js": { "maxDuration": 30 },
    "api/inspect.js": { "maxDuration": 15 },
    "api/youtube-transcript.js": { "maxDuration": 30 },
    "api/youtube-playlist.js": { "maxDuration": 30 }
  }
}
