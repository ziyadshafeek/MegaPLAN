{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:route", "destination": "/api/index?route=:route" },
    { "source": "/api/:route/:path*", "destination": "/api/index?route=:route" },
    { "source": "/folder/:path*", "destination": "/index.html" },
    { "source": "/tools/:path*", "destination": "/index.html" },
    { "source": "/wiki/:path*", "destination": "/index.html" },
    { "source": "/self", "destination": "/index.html" },
    { "source": "/desk/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  }
}
